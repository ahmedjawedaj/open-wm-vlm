include LICENSE CITATION.cff CONTRIBUTING.md CHANGELOG.md CODE_OF_CONDUCT.md SECURITY.md
include Makefile constraints-dev.txt
recursive-include configs *.json
exclude docs/*.md
include docs/dataset_card.md docs/dataset_protocol.md
include docs/dataset_stats_tetris2d.md docs/dataset_stats_tetris3d.md
recursive-include docs/assets *.png
recursive-include scripts *.py
recursive-include tests *.py
exclude CLAUDE.md NOVELTY.md PAPER_CLAIMS.md
prune .local
